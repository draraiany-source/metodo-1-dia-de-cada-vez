{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22"
    }
  ],
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "metodo1dia-app",
          "appId": "1:990266923824:android:2febdfc7c2fc1e03d886f5",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "metodo1dia-app",
          "configurations": {
            "android": "1:990266923824:android:2febdfc7c2fc1e03d886f5"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/privacidade",
        "destination": "/privacidade.html",
        "type": 301
      },
      {
        "source": "/termos",
        "destination": "/termos.html",
        "type": 301
      }
    ]
  }
}
