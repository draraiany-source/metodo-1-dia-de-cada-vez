rules_version = '2';

// Regras do Cloud Storage — Método 1 Dia de Cada Vez.
//
// Papéis:
//  - Admin Técnico: admins/{uid}
//  - Personal: users.isPersonalTrainer
//  - Aluno: dono do próprio path / vinculado em pt_students
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function isPersonalTrainer() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isPersonalTrainer == true;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function underSize(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    function ptStudentDoc(studentId) {
      return firestore.get(/databases/(default)/documents/pt_students/$(studentId));
    }

    function canAccessPtStudent(studentId) {
      return isAdmin() || (
        signedIn()
        && firestore.exists(/databases/(default)/documents/pt_students/$(studentId))
        && (
          ptStudentDoc(studentId).data.trainerId == request.auth.uid
          || ptStudentDoc(studentId).data.userId == request.auth.uid
        )
      );
    }

    // Avatar / arquivos do usuário — dono ou Admin Técnico.
    match /users/{userId}/{allPaths=**} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if signedIn()
        && request.auth.uid == userId
        && isImage()
        && underSize(8);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }

    // Conteúdo público do app (banners, capas).
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && underSize(10);
    }

    // Fotos públicas Quem Sou Eu / Amanda.
    match /public/amanda_assets/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
        && underSize(10)
        && isImage()
        && (isAdmin() || isPersonalTrainer());
      allow delete: if signedIn() && (isAdmin() || isPersonalTrainer());
    }

    match /audio_programs/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.size < 80 * 1024 * 1024
        && (request.resource.contentType.matches('audio/.*')
            || request.resource.contentType.matches('image/.*'));
      allow delete: if isAdmin();
    }

    match /programs/{programId}/audios/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.size < 80 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if isAdmin();
    }

    // Fotos de evolução — PRIVADAS (trainer/aluno vinculado/admin).
    match /pt_photos/{studentId}/{allPaths=**} {
      allow read: if canAccessPtStudent(studentId);
      allow write: if canAccessPtStudent(studentId)
        && underSize(12)
        && (isImage() || request.resource.contentType.matches('video/.*'));
      allow delete: if isAdmin() || (
        signedIn()
        && firestore.exists(/databases/(default)/documents/pt_students/$(studentId))
        && ptStudentDoc(studentId).data.trainerId == request.auth.uid
      );
    }

    match /pt_videos/{exerciseId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn()
        && underSize(80)
        && (request.resource.contentType.matches('video/.*') || isImage())
        && (isAdmin() || isPersonalTrainer());
      allow delete: if isAdmin() || isPersonalTrainer();
    }

    match /weekly_challenges/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn()
        && underSize(8)
        && isImage()
        && (isAdmin() || isPersonalTrainer());
      allow delete: if isAdmin() || isPersonalTrainer();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
