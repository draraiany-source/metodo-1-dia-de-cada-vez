rules_version = '2';

// Regras do Cloud Storage — Método 1 Dia de Cada Vez.
//
// Correções aplicadas na auditoria RC1:
//  - /public/ não é mais gravável por qualquer usuário logado (só admin).
//  - Uploads do usuário limitados a imagens de até 8 MB (custo + abuso).
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function underSize(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // Fotos de progresso e avatar — só o dono.
    match /users/{userId}/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn()
        && request.auth.uid == userId
        && isImage()
        && underSize(8);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Conteúdo público do app (banners, capas de treino).
    // Leitura aberta; escrita SOMENTE admin.
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && underSize(10);
    }

    // Fotos Quem Sou Eu / Amanda — admin OU personal trainer.
    // Mais específico que /public/{allPaths=**} para upload pelo painel da Personal.
    match /public/amanda_assets/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
        && underSize(10)
        && isImage()
        && (
          isAdmin() ||
          (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isPersonalTrainer == true)
        );
      allow delete: if signedIn() && (
        isAdmin() ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isPersonalTrainer == true)
      );
    }

    // Áudios de programas (Programa 7 Dias, etc.).
    // Leitura autenticada; escrita só admin. Premium continua protegido
    // via Firestore private + getContentUrl (não exponha URL no doc público).
    match /audio_programs/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.size < 80 * 1024 * 1024
        && (request.resource.contentType.matches('audio/.*')
            || request.resource.contentType.matches('image/.*'));
      allow delete: if isAdmin();
    }

    // Caminho canônico do seed (programs/{id}/audios/*.mp3).
    match /programs/{programId}/audios/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.size < 80 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if isAdmin();
    }

    // Mídia do Personal Trainer (fotos de evolução + vídeos de exercícios).
    match /pt_photos/{studentId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn()
        && underSize(12)
        && (isImage() || request.resource.contentType.matches('video/.*'))
        && (
          isAdmin() ||
          (firestore.exists(/databases/(default)/documents/pt_students/$(studentId))
            && (firestore.get(/databases/(default)/documents/pt_students/$(studentId)).data.trainerId == request.auth.uid
                || firestore.get(/databases/(default)/documents/pt_students/$(studentId)).data.userId == request.auth.uid))
        );
      allow delete: if signedIn() && (
        isAdmin() ||
        (firestore.exists(/databases/(default)/documents/pt_students/$(studentId))
          && firestore.get(/databases/(default)/documents/pt_students/$(studentId)).data.trainerId == request.auth.uid)
      );
    }

    match /pt_videos/{exerciseId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn()
        && underSize(80)
        && (request.resource.contentType.matches('video/.*')
            || isImage())
        && (
          isAdmin() ||
          (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isPersonalTrainer == true)
        );
      allow delete: if signedIn() && (
        isAdmin() ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isPersonalTrainer == true)
      );
    }

    // Nega o resto.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
